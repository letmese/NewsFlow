<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme (default) - window chrome only; all UI is Compose Material 3 -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- Light theme -->
    <style name="AppThemeLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark_light</item>
        <item name="android:statusBarColor">@color/bg_dark_light</item>
        <item name="android:navigationBarColor">@color/bg_dark_light</item>
    </style>
</resources>
